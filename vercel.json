{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/dbt",
      "destination": "/docs/dbt/index.html"
    },
    {
      "source": "/dbt/:match*",
      "destination": "/docs/dbt/:match*"
    },
    {
      "source": "/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/docs/:match*"
    }
  ]
}
